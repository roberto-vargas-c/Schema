generator client {
  provider   = "prisma-client-js"
  // No Rust query engine: queries go through the `pg` driver, which also runs on Cloudflare Workers.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TeamRole {
  LEAD
  MEMBER
}

enum BoardVisibility {
  WORKSPACE // every workspace member
  TEAM // only members of the board's team (plus workspace admins)
  PRIVATE // only the creator (plus workspace admins)
}

enum LinkAccess {
  NONE
  VIEW
  EDIT
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  /// Null for accounts that only sign in with Google or SSO
  passwordHash    String?
  color           String    @default("#0ea5a4")
  /// Profile picture (small WebP/JPEG/PNG), served at /api/avatars/<id>?v=<avatarVersion>
  avatar          Bytes?
  avatarMime      String?
  avatarVersion   Int       @default(0)
  emailVerifiedAt DateTime?
  /// Bumped to sign the user out everywhere (e.g. after a password reset)
  sessionVersion  Int       @default(0)
  createdAt       DateTime  @default(now())

  identities Identity[]
  authTokens AuthToken[]

  memberships WorkspaceMember[]
  teamMembers TeamMember[]
  boards      Board[]           @relation("BoardCreator")
  comments    Comment[]
  invitesSent Invite[]          @relation("InviteSender")
  stars       BoardStar[]
  folderStars FolderStar[]
  miro        MiroConnection[]
  appTokens   AppToken[]
  keystone    KeystoneConnection?
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members   WorkspaceMember[]
  teams     Team[]
  boards    Board[]
  invites   Invite[]
  folders   Folder[]
  templates BoardTemplate[]
  domains   WorkspaceDomain[]
  sso       WorkspaceSso?
  audit     AuditEvent[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  boards    Board[]
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole @default(MEMBER)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  expiresAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Board {
  id          String          @id @default(cuid())
  workspaceId String
  teamId      String?
  folderId    String?
  title       String
  createdById String
  visibility  BoardVisibility @default(WORKSPACE)
  linkAccess  LinkAccess      @default(NONE)
  shareToken  String          @unique
  /// Encoded Yjs document state (the canvas contents)
  content     Bytes?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  folder    Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy User           @relation("BoardCreator", fields: [createdById], references: [id], onDelete: Cascade)
  comments  Comment[]
  assets    Asset[]
  stars     BoardStar[]
  versions  BoardVersion[]

  @@index([workspaceId])
}

model BoardStar {
  userId  String
  boardId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([userId, boardId])
}

model Comment {
  id        String   @id @default(cuid())
  boardId   String
  authorId  String
  parentId  String?
  x         Float
  y         Float
  body      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Replies")

  @@index([boardId])
}

model Asset {
  id        String   @id @default(cuid())
  boardId   String
  mimeType  String
  /// Bytes kept in Postgres; null when the file lives in object storage (R2) under the asset id.
  data      Bytes?
  /// "db" or "r2"
  storage   String   @default("db")
  size      Int      @default(0)
  /// A small preview (longest side 512 px) of a picture, drawn when the board is zoomed out. Made in the browser.
  thumb     Bytes?
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

/// A folder (project) that groups boards inside a workspace.
model Folder {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boards    Board[]
  stars     FolderStar[]

  @@index([workspaceId])
}

/// A folder (project) someone starred, shown under Starred in their sidebar.
model FolderStar {
  userId    String
  folderId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@id([userId, folderId])
}

/// A snapshot of a board's Yjs document. Saved automatically every few minutes while people
/// edit, before a restore, or by hand with a name.
model BoardVersion {
  id           String   @id @default(cuid())
  boardId      String
  content      Bytes
  label        String?
  auto         Boolean  @default(true)
  elementCount Int      @default(0)
  createdById  String?
  createdAt    DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
}

/// A board saved as a reusable template for everyone in the workspace.
model BoardTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String   @default("")
  /// JSON array of board elements
  elements    Json
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A sign-in identity from Google or a workspace's SSO provider.
/// A Miro team the person connected with "Connect Miro" (OAuth), used to paste and import from Miro.
/// Miro hands out one token per team, so someone with boards in several teams can connect each.
model MiroConnection {
  id              String    @id @default(cuid())
  userId          String
  teamId          String
  teamName        String?
  /// Sealed with secretBox (AES-GCM keyed from AUTH_SECRET)
  accessTokenEnc  String
  refreshTokenEnc String?
  /// Null when the Miro app issues tokens that don't expire
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Identity {
  id        String   @id @default(cuid())
  userId    String
  /// "google" or "sso:<workspaceId>"
  provider  String
  subject   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

enum AuthTokenKind {
  RESET_PASSWORD
  VERIFY_EMAIL
}

/// One-time tokens sent by email. Only a hash of the token is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An email domain a workspace has claimed. Verified with a DNS TXT record.
model WorkspaceDomain {
  id          String        @id @default(cuid())
  workspaceId String
  domain      String
  verifyToken String
  verifiedAt  DateTime?
  /// People who sign up with a verified email at this domain join the workspace automatically
  autoJoin    Boolean       @default(false)
  joinRole    WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
  @@index([domain])
}

/// OpenID Connect single sign-on for a workspace (Okta, Microsoft Entra ID, Google Workspace, Auth0…).
model WorkspaceSso {
  workspaceId     String   @id
  issuer          String
  clientId        String
  /// Encrypted with a key derived from AUTH_SECRET
  clientSecretEnc String
  enabled         Boolean  @default(false)
  /// Members with an email at a verified domain must use SSO instead of a password
  enforce         Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// What happened in a workspace, for admins.
model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  actorName   String
  action      String
  targetType  String?
  targetId    String?
  targetName  String?
  details     Json?
  ip          String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

/// An app the person connected to their Schema account ("Allow Keystone to add to your boards").
/// Only a hash of the token is stored; the app holds the token itself.
model AppToken {
  id         String    @id @default(cuid())
  userId     String
  /// Which app: "keystone"
  app        String
  tokenHash  String    @unique
  /// The one-time code the token was traded for, so a code can't be used twice
  codeId     String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The person's Keystone account, connected from a board ("Add a Keystone model"). One per person.
model KeystoneConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  /// Sealed with secretBox (AES-GCM keyed from AUTH_SECRET)
  tokenEnc     String
  accountName  String?
  accountEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
